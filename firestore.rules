rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }

    // A "client" is a signed-in user with a users/{uid} profile whose role
    // is 'klient' (created via "Pridať kolegu").
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isClient() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().role == 'klient';
    }

    // An "agent" is a signed-in, non-client user whose email is explicitly
    // present in agentAllowlist. This closes the gap where anyone who can
    // sign themselves up via the public Firebase Auth API would otherwise
    // default to full staff access just by not having a client profile.
    function allowlistEntry() {
      return get(/databases/$(database)/documents/agentAllowlist/$(myEmail())).data;
    }
    function isAgent() {
      return isSignedIn() && !isClient() &&
        exists(/databases/$(database)/documents/agentAllowlist/$(myEmail()));
    }
    function isMaster() {
      return isAgent() && allowlistEntry().master == true;
    }

    function myCustomerId() {
      return myProfile().customerId;
    }
    function ticketCustomerId(ticketId) {
      return get(/databases/$(database)/documents/tickets/$(ticketId)).data.customerId;
    }

    match /tickets/{ticketId} {
      allow read: if isAgent() || (isClient() && resource.data.customerId == myCustomerId());
      // Agents: full access. Clients: may only create tickets for their own
      // company. Public intake (unauthenticated): only in a fresh,
      // unassigned, open state.
      allow create: if isAgent()
        || (isClient() && request.resource.data.customerId == myCustomerId())
        || (request.resource.data.status == 'otvoreny' &&
            request.resource.data.assignedTo == null &&
            request.resource.data.closedAt == null);
      // Public "cancel my ticket" from /support (after client-side email
      // verification against ticketLookup): may only flip an open ticket to
      // closed, touching nothing else. Everything else stays agent-only.
      allow update: if isAgent() ||
        (resource.data.status != 'uzavrety' &&
         request.resource.data.status == 'uzavrety' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt', 'updatedAt']));
      allow delete: if isAgent();

      match /messages/{messageId} {
        allow read: if isAgent() ||
          (isClient() && ticketCustomerId(ticketId) == myCustomerId() && resource.data.isPrivate == false);
        allow create: if isAgent()
          || (isClient() && ticketCustomerId(ticketId) == myCustomerId() && request.resource.data.isPrivate == false)
          || request.resource.data.isPrivate == false;
        allow update, delete: if isAgent();
      }
      match /activity/{entryId} {
        allow read: if isAgent() || (isClient() && ticketCustomerId(ticketId) == myCustomerId());
        allow create: if true;
        allow update, delete: if isAgent();
      }
    }

    // Slim public-facing shard of a ticket (code, subject, status, priority,
    // hasAgent flag, requester email) used by the /support "check status"
    // lookup: a visitor must supply the matching code AND email before the
    // app shows any ticket detail. That match is enforced client-side only
    // (Firestore rules can't see a query's "where" filter values), so this
    // is a soft deterrent, not real access control - the same accepted
    // tradeoff already made for the public customer dropdown above.
    // Written/kept in sync from tickets.ts whenever a ticket is created or
    // its status/assignment changes.
    match /ticketLookup/{code} {
      allow read: if true;
      allow create: if true;
      // Public "cancel" sync mirrors the tickets/{id} rule above: may only
      // flip status to closed, nothing else.
      allow update: if isAgent() ||
        (request.resource.data.status == 'uzavrety' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
    }

    // Anonymous live chat: the chat/message document IDs are Firestore's
    // random auto-IDs, acting as an unguessable capability token so a
    // visitor who has one can read/write only that conversation. Only
    // agents can list the full inbox.
    match /liveChats/{chatId} {
      allow get: if true;
      allow list: if isAgent();
      allow create: if true;
      allow update: if true;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
      }
    }

    // The public intake form lists existing companies in a read-only
    // dropdown (it cannot create new ones). Note: this makes customer
    // records (name, contact, email) publicly readable via the API,
    // not just via the app's UI.
    match /customers/{customerId} {
      allow read: if true;
      allow create, update, delete: if isAgent();
    }

    // Colleague (client) profiles: an agent manages them; a client may only
    // read their own profile.
    match /users/{userId} {
      allow read: if isAgent() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAgent();
    }

    // Technician roster: any agent can read it (needed for ticket
    // assignment) and self-service their own record ("Môj profil"), but
    // only the master agent can add/edit/remove other technicians.
    match /agents/{agentId} {
      allow read: if isAgent();
      allow create: if isMaster() || (isAgent() && request.resource.data.email.lower() == myEmail());
      allow update: if isMaster() || (isAgent() && resource.data.email.lower() == myEmail() && request.resource.data.email.lower() == myEmail());
      allow delete: if isMaster();
    }

    // Who is allowed to sign in as staff at all - only the master agent
    // manages this list.
    match /agentAllowlist/{email} {
      allow read: if isAgent();
      allow write: if isMaster();
    }

    match /templates/{templateId} {
      allow read, write: if isAgent();
    }

    // Knowledge-base article links shown on the public /support page.
    match /kbArticles/{articleId} {
      allow read: if true;
      allow write: if isAgent();
    }

    // Internal agent-to-agent messaging. A conversation is keyed by its
    // participants (1:1 or group); only participants may read/write it or
    // its messages. Within a message, the author may edit/delete/pin it;
    // any participant may update readBy/reactions (their own reaction only,
    // enforced by the field path itself since it's keyed by their email).
    match /conversations/{conversationId} {
      allow read: if isAgent() && myEmail() in resource.data.participants;
      allow create: if isAgent() && myEmail() in request.resource.data.participants;
      allow update: if isAgent() && myEmail() in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAgent() &&
          myEmail() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAgent() && request.resource.data.fromEmail == myEmail() &&
          myEmail() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update: if isAgent() &&
          myEmail() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          (resource.data.fromEmail == myEmail() ||
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'reactions', 'pinned']));
      }
    }

    // Public maintenance/outage announcement banner - shown to anyone
    // (clients and the public intake form), editable only by agents.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAgent();
    }

    // The ticket-number counter must be readable/incrementable by the
    // public intake form too, but only as a same-document +1 increment.
    // The round-robin assignment counter (assignmentRR) is only ever
    // touched by signed-in staff, covered by the isAgent() branch.
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAgent() ||
        (docId == 'ticketCounter' &&
         request.resource.data.keys().hasOnly(['value']) &&
         request.resource.data.value is int &&
         (!exists(/databases/$(database)/documents/meta/$(docId)) ||
          request.resource.data.value == resource.data.value + 1));
    }
  }
}
