rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /tickets/{ticketId}/{fileName} {
      allow read: if request.auth != null;
      // The public intake form can attach files to the ticket it is
      // creating, at the same trust level as public ticket creation itself.
      allow write: if request.resource.size < 50 * 1024 * 1024;
    }
  }
}
